#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

design="$repo_root/skills/design"
design_cli="$design/scripts/design"
test -f "$design/SKILL.md"
test -x "$design_cli"
test -f "$design/assets/themes/graphite.css"
test -f "$design/assets/palettes/swatches.json"
test -f "$design/assets/palettes/NOTICE.md"
test -f "$design/assets/templates/DESIGN.md"
(cd "$repo_root" && bun test skills/design/tests)
bun "$design_cli" graph --check

# Other skills point to design notes by id. Each pointer must resolve, so a
# renamed note or section fails here and not in an agent session.
design_references=$(
  grep -ohE 'design read [a-z0-9]+(-[a-z0-9]+)*(#[a-z0-9]+(-[a-z0-9]+)*)?' \
    "$repo_root/skills/internal-app/SKILL.md" \
    "$repo_root"/skills/internal-app/references/*.md \
    "$repo_root"/skills/internal-app/notes/*.md \
    "$repo_root/skills/internal-app/scripts/internal-app" |
    sed 's/^design read //' | sort -u
)
test -n "$design_references"
while IFS= read -r design_reference; do
  if [[ "$design_reference" == *"#"* ]]; then
    bun "$design_cli" read "$design_reference" >/dev/null
  else
    bun "$design_cli" read "$design_reference" --outline >/dev/null
  fi
done <<<"$design_references"

palette_files=()
for index in {01..24}; do
  palette_file="$design/assets/palettes/palette-$index.json"
  test -f "$palette_file"
  palette_files+=("$palette_file")
done

shopt -s nullglob
all_palette_files=("$design"/assets/palettes/palette-*.json)
test "${#all_palette_files[@]}" -eq "${#palette_files[@]}"

node - "${palette_files[@]}" "$design/assets/palettes/swatches.json" <<'NODE'
const fs = require("node:fs")

for (const file of process.argv.slice(2)) {
  const source = fs.readFileSync(file, "utf8")
  const json = source
    .replace(/^\s*\/\/.*$/gm, "")
    .replace(/,\s*([}\]])/g, "$1")
  const palette = JSON.parse(json)
  const colors = Object.entries(palette)

  if (colors.length === 0) {
    throw new Error(`${file}: palette is empty`)
  }

  for (const [name, value] of colors) {
    if (!/^[a-z0-9]+(?:-[a-z0-9]+)*-(?:050|[1-9]00)$/.test(name)) {
      throw new Error(`${file}: invalid color name ${name}`)
    }
    if (!/^#[0-9A-F]{6}$/.test(value)) {
      throw new Error(`${file}: invalid color value for ${name}`)
    }
  }
}
NODE

internal_app="$repo_root/skills/internal-app"
internal_app_cli="$internal_app/scripts/internal-app"
test -f "$internal_app/SKILL.md"
for reference in stack styling data charts upgrade review; do
  test -f "$internal_app/references/$reference.md"
done
test -x "$internal_app_cli"
(cd "$repo_root" && bun test skills/internal-app/tests)
test -f "$internal_app/assets/kit.json"
test -f "$internal_app/assets/template/bun.lock"
test ! -e "$internal_app/assets/template/node_modules"
test ! -e "$internal_app/assets/template/.output"
test ! -e "$internal_app/assets/template/internal-app.kit.json"
node - "$internal_app" <<'NODE'
const fs = require("node:fs")
const path = require("node:path")
const root = process.argv[2]
const manifest = JSON.parse(fs.readFileSync(path.join(root, "assets/kit.json"), "utf8"))
for (const file of manifest.files) {
  if (!fs.existsSync(path.join(root, "assets/template", file))) {
    throw new Error(`kit.json lists a missing template file: ${file}`)
  }
}
NODE
scaffold_root=$(mktemp -d)
bun "$internal_app_cli" new "$scaffold_root/app" --name "Validation app" >/dev/null
test -f "$scaffold_root/app/.oxlintrc.json"
test -f "$scaffold_root/app/.oxfmtrc.json"
test -f "$scaffold_root/app/.gitignore"
test -f "$scaffold_root/app/internal-app.kit.json"
grep -q '"name": "validation-app"' "$scaffold_root/app/package.json"
(
  cd "$scaffold_root/app"
  bun install --frozen-lockfile >/dev/null
  NODE_ENV=production bun run build >/dev/null
  bun run tsc >/dev/null
  bun run lint >/dev/null
  bun --bun oxfmt --check >/dev/null
)
bun "$internal_app_cli" check "$scaffold_root/app" >/dev/null
bun "$internal_app_cli" sync "$scaffold_root/app" >/dev/null
bun "$internal_app_cli" doctor "$scaffold_root/app" >/dev/null
# Agents read the component docs from inside an app, so the discovery path
# must work there: the catalog, one doc, and the search hit with its command.
(
  cd "$scaffold_root/app"
  bun "$internal_app_cli" components | grep -q "installed kit of the app"
  bun "$internal_app_cli" docs Kanban | grep -q "^Kanban  (pattern)"
  bun "$design_cli" search "drag cards between columns" | grep -q "internal-app.* docs Kanban"
  bun "$design_cli" graph --check >/dev/null
)
rm -rf "$scaffold_root"

test -f "$repo_root/skills/create-data-visualizations/SKILL.md"
test -f "$repo_root/skills/create-data-visualizations/scripts/chart"
test -f "$repo_root/sources/aperture.json"

npx --yes skills@1.5.22 use "$repo_root" --skill design >/dev/null
npx --yes skills@1.5.22 use "$repo_root" --skill internal-app >/dev/null
npx --yes skills@1.5.22 use "$repo_root" --skill create-data-visualizations >/dev/null
install_root=$(mktemp -d)
trap 'rm -rf "$install_root"' EXIT
(
  cd "$install_root"
  npx --yes skills@1.5.22 add "$repo_root" \
    --skill design \
    --agent opencode \
    --copy \
    --yes >/dev/null
)
installed_design="$install_root/.agents/skills/design"
test -f "$installed_design/SKILL.md"
bun "$installed_design/scripts/design" graph --check >/dev/null
bun "$installed_design/scripts/design" search "invoice preview" >/dev/null
bun "$installed_design/scripts/design" read graphite --outline >/dev/null
bun "$repo_root/skills/create-data-visualizations/scripts/chart" capabilities --json >/dev/null
bun "$repo_root/skills/create-data-visualizations/scripts/chart" schema capabilities --json >/dev/null
bun "$repo_root/skills/create-data-visualizations/scripts/chart" schema chart-spec --json >/dev/null
bun "$repo_root/skills/create-data-visualizations/scripts/chart" schema command-result --json >/dev/null
bun "$repo_root/skills/create-data-visualizations/scripts/chart" schema diagnostic --json >/dev/null
bun "$repo_root/skills/create-data-visualizations/scripts/chart" validate-spec \
  "$repo_root/skills/create-data-visualizations/assets/examples/react-time-series.json" \
  --json >/dev/null
bash "$repo_root/scripts/verify-aperture-mirror"
