#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source_dir="$repo_root/skills/ui-design/references"
target_dir="$repo_root/skills/form-design/references"
source_themes="$repo_root/skills/ui-design/assets/themes"
target_themes="$repo_root/skills/form-design/assets/themes"

mkdir -p "$target_dir" "$target_themes"
cp "$source_dir/method.md" "$target_dir/method.md"
cp "$source_dir/component-patterns.md" "$target_dir/component-patterns.md"
cp "$source_dir/dark-theme.md" "$target_dir/dark-theme.md"
cp "$source_themes/graphite.css" "$target_themes/graphite.css"
